generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Concert {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String
  eventDate   DateTime
  location    String
  venue       String
  latitude    Float?
  longitude   Float?
  bannerUrl   String
  lineupJson  String   // JSON string of bands & stages
  scheduleJson String  // JSON string of timetable
  status      String   @default("UPCOMING") // UPCOMING, ON_SALE, PAUSED, CLOSED, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zones       Zone[]
}

model Zone {
  id            Int           @id @default(autoincrement())
  concertId     Int
  concert       Concert       @relation(fields: [concertId], references: [id], onDelete: Cascade)
  name          String        // e.g. "Standing Pit A", "Grandstand Seated"
  category      String        // STANDING, SEATED, CAMPING
  status        String        @default("ON_SALE") // ON_SALE, PAUSED, CLOSED
  description   String        @default("")
  price         Float
  totalCapacity Int
  available     Int
  colorCode     String        @default("#00f0ff") // Neon color for UI mapping
  isActive      Boolean       @default(true)

  bookingItems  BookingItem[]
  tickets       Ticket[]
}

model RadarCandidate {
  id          Int      @id @default(autoincrement())
  externalId  String   @unique
  source      String
  sourceUrl   String?
  title       String
  eventDate   DateTime?
  venue       String?
  location    String?
  description String   @default("")
  imageUrl    String?
  rawJson     String   @default("{}")
  status      String   @default("NEW") // NEW, IMPORTED, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id             String        @id @default(uuid())
  bookingCode    String        @unique // e.g. "SW-98213"
  customerName   String
  customerPhone  String
  customerLineId String?       // LINE User ID for Flex Message delivery
  selectedSeats  String?       // JSON array of selected seat numbers
  lineDeliveryStatus String?   // SENT, FAILED, or NOT_LINKED
  lineDeliveryError String?
  status         String        @default("PENDING") // PENDING, PAID, CANCELLED, EXPIRED
  totalAmount    Float
  refundedAmount Float         @default(0)
  refundedAt     DateTime?
  expiresAt      DateTime      // 10 minutes lock
  paidAt         DateTime?
  paymentMethod  String        @default("PROMPTPAY")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          BookingItem[]
  tickets        Ticket[]
}

model BookingItem {
  id           Int      @id @default(autoincrement())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  zoneId       Int
  zone         Zone     @relation(fields: [zoneId], references: [id])
  quantity     Int
  pricePerUnit Float
}

model Ticket {
  id           String    @id @default(uuid())
  ticketCode   String    @unique // e.g. "SWP-PIT-A8F23"
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  zoneId       Int
  zone         Zone      @relation(fields: [zoneId], references: [id])
  attendeeName String
  seatNumber   String?   // e.g. "A-12" for Seated, null for Standing/Camping
  status       String    @default("VALID") // VALID, USED, CANCELLED
  refundedAmount Float   @default(0)
  refundedAt   DateTime?
  usedAt       DateTime?
  scannedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Staff {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  password     String?        // Legacy field; cleared after a successful password migration
  passwordHash String?
  resetTokenHash String?
  resetExpiresAt DateTime?
  name         String
  role         String         @default("GATE_STAFF") // GATE_STAFF, SUPERVISOR
  createdAt    DateTime       @default(now())
  sessions     StaffSession[]
}

model StaffSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Organizer {
  id           Int                 @id @default(autoincrement())
  username     String              @unique
  passwordHash String
  resetTokenHash String?
  resetExpiresAt DateTime?
  name         String
  createdAt    DateTime            @default(now())
  sessions     OrganizerSession[]
}

model OrganizerSession {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  organizerId  Int
  organizer    Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
}

model Customer {
  id         String        @id @default(uuid())
  username   String        @unique
  passwordHash String
  lineUserId String?       @unique
  resetTokenHash String?
  resetExpiresAt DateTime?
  createdAt  DateTime      @default(now())
  sessions   AuthSession[]
}

model AuthSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
